# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the Express server listens on (Railway/Render set this automatically,
# but keep a local default for testing).
PORT=3000

# The exact word an employee replies with to stop their reminders.
# Matching is case-insensitive and ignores leading/trailing spaces.
STOP_KEYWORD=DONE

# --- Google Sheets access (for writing the Remark column back) ---
# Path to the service account JSON key file (see README for how to create one).
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# --- Persistence paths (don't change unless you know why) ---
AUTH_FOLDER=./auth_info
JOBS_FILE=./jobs.json
